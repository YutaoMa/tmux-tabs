{
  "manifest_version": 3,
  "name": "tmux-tabs",
  "version": "0.1.0",
  "description": "Sync Chrome tab groups with tmux sessions",
  "permissions": ["tabGroups", "tabs", "nativeMessaging", "contextMenus", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tmux-tabs"
  }
}
